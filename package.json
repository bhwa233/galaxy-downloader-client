{
  "name": "bhwa233-download-client",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first media downloader with browser login-state support.",
  "license": "AGPL-3.0-only",
  "author": "bhwa233",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "pnpm typecheck && vite build",
    "package": "pnpm engine:build && pnpm build && electron-builder --publish never",
    "engine:dev": "node scripts/prepare-engine.mjs",
    "engine:build": "node scripts/prepare-engine.mjs --bundle",
    "test": "vitest run",
    "test:live:profiles": "vitest run --config vitest.live.config.ts",
    "test:e2e": "pnpm build && playwright test",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "playwright-core": "1.63.0",
    "ffmpeg-static": "5.3.0",
    "zod": "^4.3.6",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-progress": "^1.1.9",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "lucide-react": "^1.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.0.1",
    "vitest": "^4.1.8",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.4",
    "typescript-eslint": "^8.0.0",
    "@eslint/js": "^9.39.4"
  },
  "packageManager": "pnpm@11.8.0"
}
