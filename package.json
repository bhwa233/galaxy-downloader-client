{
  "name": "galaxy-downloader",
  "version": "0.4.3",
  "private": true,
  "description": "Local-first media downloader with browser login-state support.",
  "license": "AGPL-3.0-only",
  "author": "bhwa233",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "pnpm typecheck && vite build && vite build --config vite.cli.config.ts",
    "galaxy": "vite build --config vite.cli.config.ts && GALAXY_DEV=1 node dist-electron/cli/galaxy.mjs",
    "package": "pnpm engine:build && pnpm build && electron-builder --publish never",
    "engine:dev": "node scripts/prepare-engine.mjs",
    "engine:build": "node scripts/prepare-engine.mjs --bundle",
    "test": "vitest run",
    "test:live:profiles": "pnpm build && playwright test --config playwright.live.config.ts profiles",
    "test:live:links": "pnpm build && playwright test --config playwright.live.config.ts links",
    "test:e2e": "pnpm build && playwright test",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3",
    "i18next": "^26.4.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@eslint/js": "^9.39.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "commander": "^15.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.8.1",
    "eslint": "^10.11.0",
    "ffmpeg-static": "5.3.0",
    "lucide-react": "^1.48.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.15",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.1",
    "vite-plugin-electron": "^1.0.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@11.8.0"
}
